# Normalize text files in the repository.
* text=auto eol=lf

# Source and configuration files.
*.php       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.sh        text eol=lf
Dockerfile   text eol=lf
*.conf       text eol=lf
*.ini        text eol=lf
*.htaccess  text eol=lf

.env.example text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
LICENSE      text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
